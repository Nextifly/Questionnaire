model Solutions {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solution_code String @unique

  class        String
  name         String
  country      String
  description  String
  phisics_and_chemistry String

  target_problem String?
  quantitative_effect_min String?
  quantitative_effect_max String?

  kin_increase_min Float?
  kin_increase_max Float?

  oil_production_growth_min Float?
  oil_production_growth_max Float?

  watercut_reduction_min Float?
  watercut_reduction_max Float?

  cost_reduction_min Float?
  cost_reduction_max Float?

  env_impact_reduction_min Float?
  env_impact_reduction_max Float?

  implementation_cost String?
  validation_metrics String?

  impact_kin Int?
  impact_oil Int?
  impact_watercut Int?
  impact_cost Int?
  impact_env Int?

  integrated_score Float?

  applicability_conditions String?
  risks_limitations String?
  readiness String?

  @@map("solutions")
}